{
  "name": "mineradio-desktop-lyrics",
  "version": "0.2.1",
  "private": false,
  "license": "GPL-3.0-only",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:bridge": "electron . --source=inflink-api --audio=inflink-pcm --frame-rate=30",
