{
  "manifest_version": 1,
  "name": "MineradioBridge",
  "version": "0.4.3",
  "author": "Mineradio external lyrics prototype",
  "description": "Read-only, authenticated local InfLink state bridge",
  "betterncm_version": ">=1.3.4",
